[node name="ShopItemsList" type="VBoxContainer" parent="UILayer/ShopOverlay/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 8

[node name="BtnBuyLoaded" type="Button" parent="UILayer/ShopOverlay/Margin/VBox/ShopItemsList"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
text = "🎲 Dado Cargado (Tira 2 veces, guarda el mayor) — 5 🪙"

[node name="BtnBuyWildcard" type="Button" parent="UILayer/ShopOverlay/Margin/VBox/ShopItemsList"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
text = "⭐ Dado Comodín (Cuenta para cualquier cara) — 8 🪙"

[node name="BtnBuyCrystal" type="Button" parent="UILayer/ShopOverlay/Margin/VBox/ShopItemsList"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
text = "💎 Dado de Cristal (Visible, pero da +3 oro por victoria) — 6 🪙"

[node name="BtnBuyVampiric" type="Button" parent="UILayer/ShopOverlay/Margin/VBox/ShopItemsList"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
text = "🩸 Dado Vampírico (Si puntúa al ganar, cura 1 dado) — 7 🪙"

[node name="BtnBuyTrick" type="Button" parent="UILayer/ShopOverlay/Margin/VBox/ShopItemsList"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
text = "🧪 Sobre de Truco (Consumible sorpresa de manga) — 4 🪙"

[node name="BtnBuyRelic" type="Button" parent="UILayer/ShopOverlay/Margin/VBox/ShopItemsList"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
text = "🏺 Reliquia Misteriosa (Poder pasivo permanente) — 6 🪙"

[node name="BtnRecoverDie" type="Button" parent="UILayer/ShopOverlay/Margin/VBox/ShopItemsList"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
text = "➕ Recuperar 1 Dado Perdido para tu cubilete — 4 🪙"

[node name="NextEncounterLabel" type="Label" parent="UILayer/ShopOverlay/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.78, 0.35, 1)
theme_override_fonts/font = ExtResource("2_pixel_font")
theme_override_font_sizes/font_size = 11
text = "Próximo Encuentro: ..."
horizontal_alignment = 1

[node name="BtnNextMatch" type="Button" parent="UILayer/ShopOverlay/Margin/VBox"]
custom_minimum_size = Vector2(240, 40)
layout_mode = 2
size_flags_horizontal = 4
theme_override_fonts/font = ExtResource("2_pixel_font")
theme_override_font_sizes/font_size = 12
text = "Siguiente Rival ➡️"

