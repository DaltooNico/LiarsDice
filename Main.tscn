[node name="PlayerArea" type="HBoxContainer" parent="UILayer/VBox"]
layout_mode = 2

[node name="Label" type="Label" parent="UILayer/VBox/PlayerArea"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Tus dados: "

[node name="BettingPanel" type="HBoxContainer" parent="UILayer/VBox"]
